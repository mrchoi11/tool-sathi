<IfModule mod_env.c>
  SetEnvIf Request_URI "^/api/.*" no-gzip dont-vary
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Dynamic XML Sitemaps (Yoast / RankMath Style Index & Sub-Sitemaps)
  RewriteRule ^sitemap\.xml$ /api/sitemap.php?type=index [QSA,L]
  RewriteRule ^sitemap_index\.xml$ /api/sitemap.php?type=index [QSA,L]
  RewriteRule ^post-sitemap\.xml$ /api/sitemap.php?type=post [QSA,L]
  RewriteRule ^page-sitemap\.xml$ /api/sitemap.php?type=page [QSA,L]
  RewriteRule ^tool-sitemap\.xml$ /api/sitemap.php?type=tool [QSA,L]
  RewriteRule ^category-sitemap\.xml$ /api/sitemap.php?type=category [QSA,L]

  # 2. Allow direct access to existing files in /api/
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^api/ - [L]

  # 3. Route /api and /api/ to native TeraBox PHP gateway
  RewriteRule ^api/?$ /api/terabox.php [QSA,L]
  RewriteRule ^api/(.*)$ /api/terabox.php [QSA,L]

  # 4. SPA routing - all non-file requests go to index.html
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
