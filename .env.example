# TeraBox Streaming Proxy — copy this file to .env and fill in your values

PORT=3000

# Paste your TeraBox 'ndus' cookie value here (get it from terabox.com browser cookies)
TERABOX_COOKIE=YOUR_NDUS_COOKIE_HERE
NDUS=YOUR_NDUS_COOKIE_HERE

# Diskwala Resolver / API Configuration (Optional)
# If using a paid/community Diskwala resolver gateway (e.g. teraboxapi.com), add key:
DISKWALA_API_KEY=
DISKWALA_RESOLVER_URL=https://api.teraboxapi.com/v1/diskwala

# Downloader Gateway Configuration
# Default uses local PHP gateway on the same origin: /api/downloader.php
# If hosting the gateway on Cloudflare Worker or external VPS, set full URL:
VITE_DOWNLOADER_API_URL=/api/downloader.php

# Optional Backend Providers for YouTube / Instagram (configured in public/api/config.php or environment)
# DOWNLOADER_YOUTUBE_PROVIDER=https://your-vps.com/api/yt-dlp
# DOWNLOADER_INSTAGRAM_PROVIDER=https://your-vps.com/api/instagram

# Firebase Configuration
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
